
# FlowPulse AI — Local development configuration
# ROADPULSE_ names remain because the backend still uses this prefix.

# ---------------------------------------------
# APPLICATION
# ---------------------------------------------

ROADPULSE_ENV=development
ROADPULSE_HOST=127.0.0.1
ROADPULSE_PORT=8000

# Do not automatically launch a synthetic demo or camera.
ROADPULSE_AUTOSTART=false

ROADPULSE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROADPULSE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ---------------------------------------------
# DATABASE
# ---------------------------------------------

# Keep the existing database path to preserve current records.
ROADPULSE_DATABASE_URL=sqlite:///./runtime/roadpulse.db

# ---------------------------------------------
# CAMERA
# ---------------------------------------------

# Inactive fallback configuration.
# Select the live iPhone camera in the browser interface.
ROADPULSE_CAMERA_MODE=replay
ROADPULSE_CAMERA_URL=
ROADPULSE_REPLAY_PATH=

ROADPULSE_CAMERA_ID=configured
ROADPULSE_CAMERA_NAME=Authorized Camera
ROADPULSE_CAMERA_REGION=
ROADPULSE_CAMERA_PROVIDER=
ROADPULSE_CAMERA_SOURCE_PAGE=
ROADPULSE_CAMERA_TERMS_URL=

# ---------------------------------------------
# CAMERA PERMISSIONS
# ---------------------------------------------

ROADPULSE_CAMERA_ANALYSIS_AUTHORIZED=false
ROADPULSE_CAMERA_REDISPLAY_AUTHORIZED=false
ROADPULSE_CAMERA_PERMISSION_NOTES=
ROADPULSE_CAMERA_PERMISSION_CHECKED=

ROADPULSE_CAMERA_ALLOWED_HOSTS=
ROADPULSE_CAMERA_ALLOW_PRIVATE=false
ROADPULSE_CAMERA_OWNED=false

# Local iPhone / Mac camera.
# Choose the actual device in the UI.
# Device indices can change after reconnection.
ROADPULSE_LOCAL_CAMERA_INDEX=0
ROADPULSE_LOCAL_CAMERA_AUTHORIZED=false

# ---------------------------------------------
# AI MODEL — PERSON DETECTION
# ---------------------------------------------

ROADPULSE_DETECTION_TARGET=person

ROADPULSE_TARGET_FPS=2

ROADPULSE_MODEL_NAME=yolo11n.pt
ROADPULSE_MODEL_PATH=runtime/models/yolo11n.pt

# Stable starting configuration for your Mac.
ROADPULSE_DEVICE=cpu

# ---------------------------------------------
# PRIVACY
# ---------------------------------------------

# No evidence-image recording by default.
ROADPULSE_SAVE_EVIDENCE=false

ROADPULSE_EVIDENCE_TTL_HOURS=24
ROADPULSE_EVIDENCE_DIR=runtime/evidence

# ---------------------------------------------
# LEGACY TRAFFIC DATA INTEGRATION
# ---------------------------------------------

# Not needed for the FlowPulse Studio people-flow experience.
ROADPULSE_DIGITRAFFIC_ENABLED=false
